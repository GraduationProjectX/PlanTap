# Copy to .env.local and fill in your own values.
# This file is safe to commit; .env.local is git-ignored.

# Required: Convex client URL used by the mobile app.
EXPO_PUBLIC_CONVEX_URL=https://YOUR-CONVEX-PROJECT.convex.cloud

# Required: Clerk publishable key for Expo app auth.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY

# Optional: Sentry DSN (leave blank to disable Sentry locally).
EXPO_PUBLIC_SENTRY_DSN=

# Optional: Convex site URL used by some backend HTTP flows.
EXPO_PUBLIC_CONVEX_SITE_URL=https://YOUR-CONVEX-PROJECT.convex.site
