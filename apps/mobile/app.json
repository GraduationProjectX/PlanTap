{
  "expo": {
    "name": "PlanTap",
    "slug": "plantap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/planTap-icon.png",
    "scheme": "plantap",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/planTap-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.plantap.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/planTap-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.plantap.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/planTap-icon.png"
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native/expo",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PlanTap to show your location and sort nearby events on the map."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
